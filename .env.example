# Copy to .env for local development. Never commit .env.
# In AWS, every value marked [secret] is read from AWS Secrets Manager
# (secret name in the comment), never from plain environment variables.

# Runtime mode: local | aws
RF_MODE=local

# Local mode storage root (gitignored)
RF_LOCAL_DATA_DIR=.local-data

# AWS (only for RF_MODE=aws; credentials come from your AWS profile / OIDC, not from here)
AWS_REGION=eu-central-1
RF_BEDROCK_MODEL_ID=

# Extractor: fake | recorded | bedrock
RF_EXTRACTOR=recorded

# KoSIT validator daemon (docker compose service)
RF_KOSIT_URL=http://localhost:8081

# Langfuse Cloud EU. Leave empty to disable tracing (no-op).
# [secret] in AWS: rechnungsfluss/<env>/langfuse
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Review API dev-token signing key (local only; Cognito is used in AWS)
# [secret] generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RF_DEV_JWT_SECRET=
